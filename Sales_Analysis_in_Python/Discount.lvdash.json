{
  "datasets": [
    {
      "name": "7c70a731",
      "displayName": "Revenue and Orders Summary Dataset",
      "queryLines": [
        "SELECT\n",
        "  to_date(MonthStart) AS month,\n",
        "  SUM(CountedRevenue) AS revenue,\n",
        "  COUNT(DISTINCT CASE WHEN CountsAsRevenue = 'Yes' THEN OrderID END) AS orders,\n",
        "  SUM(CountedRevenue) / COUNT(DISTINCT CASE WHEN CountsAsRevenue = 'Yes' THEN OrderID END) AS avg_order_value,\n",
        "  CASE WHEN to_date(MonthStart) >= DATE'2026-02-01' THEN 'From Feb 2026' ELSE 'Before Feb 2026' END AS phase\n",
        "FROM workspace.default.shop_joined\n",
        "WHERE MonthStart IS NOT NULL\n",
        "GROUP BY 1, 5\n",
        "ORDER BY month\n",
        "\n"
      ]
    },
    {
      "name": "1afa8f12",
      "displayName": "Customer Segment Average Revenue Per User Metrics",
      "queryLines": [
        "SELECT CustomerSegment,\n",
        "       SUM(CountedRevenue) / COUNT(DISTINCT CustomerID) AS revenue_per_customer\n",
        "FROM workspace.default.shop_joined\n",
        "WHERE CountsAsRevenue = 'Yes' AND CustomerSegment <> 'Unknown'\n",
        "GROUP BY CustomerSegment"
      ]
    },
    {
      "name": "7fc89a73",
      "displayName": "Order Status Distribution and Percentage Summary",
      "queryLines": [
        "SELECT Status, ROUND(100 * COUNT(*) / SUM(COUNT(*)) OVER (), 1) AS pct_of_orders\n",
        "FROM workspace.default.shop_joined\n",
        "GROUP BY Status"
      ]
    },
    {
      "name": "f6691125",
      "displayName": "Payment Method Failure Rates Analysis",
      "queryLines": [
        "SELECT PaymentMethod,\n",
        "       ROUND(100 * AVG(CASE WHEN PaymentStatus = 'Failed' THEN 1 ELSE 0 END), 1) AS failed_pct\n",
        "FROM workspace.default.shop_joined\n",
        "WHERE PaymentMethod <> 'Unknown'\n",
        "GROUP BY PaymentMethod\n",
        "ORDER BY failed_pct DESC"
      ]
    },
    {
      "name": "8ff8a268",
      "displayName": "Discount Analysis Metrics for Revenue Tracking",
      "queryLines": [
        "SELECT CONCAT(CAST(ROUND(Discount * 100) AS INT), '%') AS discount_label,\n",
        "       Discount,\n",
        "       AVG(CountedRevenue) AS avg_order_value,\n",
        "       AVG(Quantity) AS avg_units\n",
        "FROM workspace.default.shop_joined\n",
        "WHERE CountsAsRevenue = 'Yes'\n",
        "GROUP BY Discount\n",
        "ORDER BY Discount"
      ]
    },
    {
      "name": "3768e4ad",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  SUM(CountedRevenue) AS total_revenue,\n",
        "  COUNT(DISTINCT CASE WHEN CountsAsRevenue = 'Yes' THEN OrderID END) AS orders,\n",
        "  SUM(CountedRevenue) / COUNT(DISTINCT CASE WHEN CountsAsRevenue = 'Yes' THEN OrderID END) AS avg_order_value\n",
        "FROM workspace.default.shop_joined"
      ]
    },
    {
      "name": "7069fa1d",
      "displayName": "Cities",
      "queryLines": [
        "SELECT City, SUM(CountedRevenue) AS revenue\n",
        "FROM workspace.default.shop_joined\n",
        "WHERE City <> 'Unknown'\n",
        "GROUP BY City\n",
        "ORDER BY revenue DESC"
      ]
    },
    {
      "name": "33b8b6e6",
      "displayName": "Segments",
      "queryLines": [
        "SELECT CustomerSegment,\n",
        "       SUM(CountedRevenue) / COUNT(DISTINCT CustomerID) AS revenue_per_customer\n",
        "FROM workspace.default.shop_joined\n",
        "WHERE CountsAsRevenue = 'Yes' AND CustomerSegment <> 'Unknown'\n",
        "GROUP BY CustomerSegment"
      ]
    },
    {
      "name": "f8be2ef1",
      "displayName": "Products dataset",
      "queryLines": [
        "WITH p AS (\n",
        "  SELECT\n",
        "    ProductName,\n",
        "    SUM(CountedRevenue) AS revenue,\n",
        "    SUM(CASE WHEN CountsAsRevenue = 'Yes' THEN Quantity ELSE 0 END) AS units\n",
        "  FROM workspace.default.shop_joined\n",
        "  GROUP BY ProductName\n",
        ")\n",
        "SELECT\n",
        "  ProductName,\n",
        "  revenue,\n",
        "  units,\n",
        "  CONCAT(LPAD(CAST(RANK() OVER (ORDER BY revenue DESC) AS STRING), 2, '0'), '. ', ProductName) AS revenue_label,\n",
        "  CONCAT(LPAD(CAST(RANK() OVER (ORDER BY units DESC) AS STRING), 2, '0'), '. ', ProductName) AS units_label\n",
        "FROM p\n",
        "ORDER BY revenue DESC"
      ]
    }
  ],
